# =======================================================
# NALANDA ENT CENTER - PRODUCTION ENVIRONMENT VARIABLES
# =======================================================

# 1. MongoDB Connection URI (Get from MongoDB Atlas: https://www.mongodb.com/cloud/atlas)
# Replace <username>, <password>, and cluster domain with your Atlas credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/nalanda_ent?retryWrites=true&w=majority

# 2. JWT Secret Key for Authentication
JWT_SECRET=nalanda_ent_super_secret_jwt_key_2026_prod

# 3. Server Port (Set automatically by Render / Heroku / Railway)
PORT=5000

# 4. Frontend Production API URL (For Vite build)
VITE_API_URL=https://nalanda-ent-api.onrender.com/api
